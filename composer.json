{
    "name": "omnipulse/github-sponsors",
    "type": "library",
    "description": "Omnipulse's GitHub Sponsors, under any PHP host: a user's or an organization's listing read through GitHub's GraphQL API - its page, its goal, its tiers, the number of sponsors and the public ones.",
    "keywords": [
        "sponsors",
        "github-sponsors",
        "github",
        "graphql",
        "funding",
        "framework-agnostic",
        "omnipulse"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnipulse-github-sponsors",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0",
        "omnisense/omnipulse": "^1.0",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "replace": {
        "omnifund/github-sponsors": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Omnipulse\\GitHubSponsors\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipulse\\GitHubSponsors\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
